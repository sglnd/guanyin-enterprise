# Update a prebuilt enterprise runtime without downloading the pinned plugin archive set.
ARG BASE_IMAGE=bankops/guanyin-enterprise-dsh:0.1.5-rc.2-gy.ent.2-arm64
FROM ${BASE_IMAGE}
USER root
COPY deploy/dsh-0.1.5-core/guanyin-ui-policy/lib/client.js /tmp/guanyin-ui-client.js
RUN cp /tmp/guanyin-ui-client.js /opt/dsh-seed/profiles/web/node_modules/@guanyin/dsh-ui-policy/lib/client.js \
    && printf '%s\n' 'dsh=0.1.5-rc.2' 'profile=guanyin-enterprise-v3' > /opt/dsh-seed/.bankops-release \
    && rm /tmp/guanyin-ui-client.js \
    && chown -R node:node /opt/dsh-seed/profiles/web/node_modules/@guanyin/dsh-ui-policy /opt/dsh-seed/.bankops-release
COPY deploy/dsh-0.1.5-core/model-sync.mjs /opt/dsh-runtime/model-sync.mjs
COPY deploy/dsh-0.1.5-core/web-proxy.mjs /opt/dsh-runtime/web-proxy.mjs
COPY deploy/dsh-0.1.5-core/entrypoint.sh /usr/local/bin/dsh-core-entrypoint
COPY deploy/dsh-enterprise/entrypoint.sh /usr/local/bin/guanyin-enterprise-entrypoint
RUN chmod 0755 /usr/local/bin/dsh-core-entrypoint /usr/local/bin/guanyin-enterprise-entrypoint
LABEL org.opencontainers.image.version="0.1.5-rc.2-gy.ent.3" \
      io.guanyin.models-contract="1" \
      io.guanyin.edition="enterprise" \
      io.guanyin.profile="guanyin-enterprise-v3"
USER node
ENTRYPOINT ["guanyin-enterprise-entrypoint"]
